{
  "apiVersion": 1,
  "id": "multi2api",
  "name": "Multi2API",
  "short": "M2",
  "description": "WorkBuddy / CodeBuddy 多账号 OpenAI 兼容网关：账号池轮询、定时签到保活与故障自愈，聚合支持 WorkBuddy、字节 Trae、智谱 Z.ai、MiniMax、华为云等主流平台。",
  "version": "1.0.0",
  "icon": "icon.svg",
  "category": "api-gateway",
  "author": "Practice019",
  "homepage": "https://github.com/Practice019/multi2api",
  "license": "MIT",
  "runtime": {
    "type": "binary",
    "binary": "wb2api-server{ext}",
    "args": [
      "-config",
      "config.json"
    ],
    "workdir": "{installPath}",
    "port": "{config.port}",
    "stopSignal": "SIGTERM",
    "stopTimeout": 30000,
    "env": {}
  },
  "healthCheck": {
    "type": "custom",
    "intervalSeconds": 30,
    "timeoutSeconds": 5,
    "healthyThreshold": 2,
    "unhealthyThreshold": 3
  },
  "configSchema": [
    {
      "key": "port",
      "label": "监听端口",
      "type": "number",
      "default": 7863,
      "required": true,
      "description": "网关监听端口（上游默认 7863）。改动后需要「重新生成配置文件」再重启",
      "hidden": false,
      "generate": null,
      "immutable": false
    },
    {
      "key": "apiKey",
      "label": "API 密钥",
      "type": "password",
      "default": "",
      "required": true,
      "description": "OpenAI 兼容接口的 Bearer 密钥。填写到 AnyBridge 供应商的 API Key 一栏",
      "hidden": false,
      "generate": "base64-32",
      "immutable": false
    },
    {
      "key": "adminToken",
      "label": "管理令牌",
      "type": "password",
      "default": "",
      "required": true,
      "description": "管理控制台与 /admin/* 的门禁令牌，独立于 API 密钥（本机访问免令牌）",
      "hidden": true,
      "generate": "base64-32",
      "immutable": false
    }
  ],
  "capabilities": [
    "lifecycle",
    "health-check",
    "logs"
  ],
  "panels": [
    {
      "id": "overview",
      "title": "概览",
      "type": "builtin",
      "order": 1,
      "fields": [
        {
          "key": "status",
          "label": "状态",
          "type": "status-light"
        },
        {
          "key": "port",
          "label": "端口",
          "type": "text"
        },
        {
          "key": "version",
          "label": "版本",
          "type": "text"
        },
        {
          "key": "uptime",
          "label": "运行时间",
          "type": "duration"
        }
      ]
    },
    {
      "id": "gateway",
      "title": "网关状态",
      "type": "builtin",
      "order": 2,
      "capability": "health-check",
      "requiresAuth": false,
      "loadFrom": "getGatewayStatus",
      "actions": [
        {
          "id": "openConsole",
          "label": "打开管理控制台",
          "type": "button",
          "confirm": false,
          "method": "openConsole"
        },
        {
          "id": "switchVersion",
          "label": "切换版本",
          "type": "prompt",
          "promptLabel": "目标版本（如 v1.7.3 或 v1.8.0）",
          "confirm": false,
          "method": "switchVersion"
        }
      ],
      "fields": [
        {
          "key": "service",
          "label": "服务名",
          "type": "text"
        },
        {
          "key": "apiBase",
          "label": "API 地址",
          "type": "text"
        },
        {
          "key": "version",
          "label": "网关版本",
          "type": "text"
        },
        {
          "key": "models",
          "label": "可用模型",
          "type": "number"
        },
        {
          "key": "apiKey",
          "label": "API 密钥",
          "type": "text"
        }
      ]
    },
    {
      "id": "logs",
      "title": "日志",
      "type": "builtin",
      "order": 3,
      "capability": "logs"
    }
  ],
  "deploy": {
    "strategies": [
      "adapter"
    ],
    "asset": {
      "repo": "Practice019/multi2api",
      "name": "wb2api-server-{goos}-{goarch}.{archive_ext}",
      "binary": "wb2api-server{ext}",
      "versionFile": ".wb2api-version",
      "stripComponents": 1
    },
    "adapter": {
      "doc": "deploy.md",
      "installer": "adapter.js",
      "minDiskMB": 120,
      "estimatedTime": "1-2min",
      "requiresNetwork": true,
      "requiresAdmin": false
    }
  },
  "upgrade": {
    "type": "github-release",
    "repo": "Practice019/multi2api",
    "checkInterval": "24h",
    "autoCheck": true
  },
  "credentials": [
    {
      "subtitle": "Multi2API (OpenAI 兼容)",
      "rows": [
        {
          "label": "API Key",
          "value": "{config.apiKey}",
          "copy": true
        },
        {
          "label": "API 地址",
          "value": "http://127.0.0.1:{port}/v1",
          "copy": true
        }
      ]
    },
    {
      "subtitle": "Multi2API 管理控制台",
      "rows": [
        {
          "label": "访问模式",
          "value": "本机免令牌直达（打开控制台即进入）"
        },
        {
          "label": "面板地址",
          "value": "http://127.0.0.1:{port}/ui",
          "copy": true
        }
      ]
    }
  ]
}
